; Engine configuration file.
config_version=5

[application]

config/name="Wild Pakistan - The Last Wilderness"
config/description="3D wildlife survival and conservation game set in Pakistan's Thar Desert, Ziarat Juniper Forest and northern mountains."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.09, 0.08, 1)

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
Events="*res://scripts/autoload/events.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
MissionManager="*res://scripts/autoload/mission_manager.gd"
AdManager="*res://scripts/autoload/ad_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=1024
